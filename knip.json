{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreDependencies": [
        "@hookform/resolvers",
        "@jterrazz/typescript",
        "@vercel/analytics",
        "@vercel/speed-insights",
        "postcss",
        "react-hook-form"
    ],
    "ignoreBinaries": ["oxlint", "oxfmt"],
    "ignore": ["oxfmt.config.ts", "oxlint.config.ts"],
